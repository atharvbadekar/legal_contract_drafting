# Database (PostgreSQL with pgvector)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/mira_db?schema=public"

# Backend
PORT=5000
NODE_ENV=development
JWT_SECRET="atharv_legal_jwt_secret_key_2026_secure"
RAG_TOP_K=5

# Python Legal NLP Service (Domain Legal-BERT / sentence-transformers/all-MiniLM-L6-v2)
LEGAL_NLP_URL="http://localhost:8001"
LEGAL_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
LEGAL_MODEL_DEVICE="cpu"
LEGAL_MAX_LENGTH=512

# Provider-Agnostic LLM Configuration (Free / Free-Tier / Local)
# Primary options: "groq" | "gemini" | "openrouter" | "mistral" | "ollama" | "deterministic"
LLM_PROVIDER_PRIMARY="groq"
# Fallback options: "ollama" | "deterministic" | "groq" | "gemini"
LLM_PROVIDER_FALLBACK="deterministic"

# Hosted Free-Tier Option: Groq (Ultra-fast, Llama 3.1 8B Instant)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.1-8b-instant"
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# Hosted Free-Tier Option: Google Gemini (Google AI Studio Free Tier)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"

# Hosted Free-Tier Option: OpenRouter Free Models (e.g. meta-llama/llama-3.3-70b-instruct:free)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/free"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Local/Self-Hosted Option: Ollama (Zero cost, air-gapped, e.g. qwen2.5:7b-instruct or llama3.2:3b)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:7b-instruct"

# Rate Limiter & Cache
LLM_TIMEOUT_MS=15000
LLM_MAX_RETRIES=2
LLM_CACHE_TTL_MS=3600000

# Storage
UPLOAD_DIR="./storage"
