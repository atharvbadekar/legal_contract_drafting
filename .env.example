# Database (PostgreSQL with pgvector)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/mira_db?schema=public"

# Backend
PORT=5000
NODE_ENV=development
JWT_SECRET="mira_research_jwt_secret_key_2026_secure"
RAG_TOP_K=5

# Python Legal NLP Service (sentence-transformers/all-MiniLM-L6-v2)
LEGAL_NLP_URL="http://localhost:8001"
LEGAL_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
LEGAL_MODEL_DEVICE="cpu"
LEGAL_MAX_LENGTH=512

# Open-Weight Generation Model
GENERATION_MODEL_NAME="open-weight/mira-legal-draft-v1"
GENERATION_SERVICE_URL="http://localhost:8001/generation"

# Storage
UPLOAD_DIR="./storage"
