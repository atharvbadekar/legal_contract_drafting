datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum Role {
  USER
  ADMIN
}

enum DocumentStatus {
  DRAFT
  VALIDATING
  COMPLETED
  NEEDS_REVIEW
}

enum GenerationMode {
  BASELINE
  MIRA
}

enum ClauseStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

enum ValidationLayer {
  DETERMINISTIC
  LEGAL_BERT
  LLM_REVIEW
}

model User {
  id           String              @id @default(uuid())
  email        String              @unique
  passwordHash String
  name         String
  role         Role                @default(USER)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  documents    Document[]
  versions     DocumentVersion[]
  knowledge    KnowledgeDocument[]
  auditLogs    AuditLog[]

  @@map("users")
}

model Document {
  id                String             @id @default(uuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  documentType      String             // NDA, LEGAL_NOTICE
  status            DocumentStatus     @default(DRAFT)
  generationMode    GenerationMode     @default(MIRA)
  structuredFacts   Json               @default("{}")
  content           String             @db.Text
  validationScore   Float              @default(0.0)
  validationSummary Json               @default("{}")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  versions          DocumentVersion[]
  agentRuns         AgentRun[]
  validationResults ValidationResult[]

  @@map("documents")
}

model DocumentVersion {
  id               String   @id @default(uuid())
  documentId       String
  document         Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber    Int
  structuredFacts  Json     @default("{}")
  content          String   @db.Text
  validationResult Json     @default("{}")
  createdById      String
  createdBy        User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@unique([documentId, versionNumber])
  @@map("document_versions")
}

model DocumentType {
  id          String     @id @default(uuid())
  code        String     @unique // NDA, LEGAL_NOTICE
  name        String
  description String
  createdAt   DateTime   @default(now())
  templates   Template[]

  @@map("document_types")
}

model Template {
  id             String            @id @default(uuid())
  documentTypeId String
  documentType   DocumentType      @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  name           String
  description    String
  version        Int               @default(1)
  isDefault      Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  sections       TemplateSection[]

  @@map("templates")
}

model TemplateSection {
  id                 String   @id @default(uuid())
  templateId         String
  template           Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sectionKey         String   // e.g. confidentiality, governing_law
  title              String
  orderIndex         Int
  isRequired         Boolean  @default(true)
  defaultPromptGuide String   @db.Text
  defaultContent     String?  @db.Text

  @@map("template_sections")
}

model Clause {
  id           String                   @id @default(uuid())
  title        String
  documentType String                   // NDA, LEGAL_NOTICE
  clauseType   String                   // confidentiality, remedies, etc.
  content      String                   @db.Text
  jurisdiction String                   @default("India")
  status       ClauseStatus             @default(DRAFT)
  version      Int                      @default(1)
  source       String?
  embedding    Unsupported("vector(768)")?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@map("clauses")
}

model KnowledgeDocument {
  id            String           @id @default(uuid())
  title         String
  source        String
  jurisdiction  String           @default("India")
  documentType  String           // NDA, LEGAL_NOTICE, STATUTE, GENERAL
  effectiveDate String?
  uploadedById  String
  uploadedBy    User             @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  chunks        KnowledgeChunk[]

  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id             String                   @id @default(uuid())
  knowledgeDocId String
  document       KnowledgeDocument        @relation(fields: [knowledgeDocId], references: [id], onDelete: Cascade)
  chunkIndex     Int
  content        String                   @db.Text
  metadata       Json                     @default("{}")
  embedding      Unsupported("vector(768)")?

  @@map("knowledge_chunks")
}

model ValidationResult {
  id          String          @id @default(uuid())
  documentId  String
  document    Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  layer       ValidationLayer
  status      String          // PASSED, FAILED, WARNING
  score       Float
  issues      Json            @default("[]")
  createdAt   DateTime        @default(now())

  @@map("validation_results")
}

model AgentRun {
  id          String      @id @default(uuid())
  documentId  String
  document    Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  status      String      // RUNNING, COMPLETED, FAILED, NEEDS_REVIEW
  startedAt   DateTime    @default(now())
  completedAt DateTime?
  steps       AgentStep[]

  @@map("agent_runs")
}

model AgentStep {
  id              String    @id @default(uuid())
  agentRunId      String
  agentRun        AgentRun  @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  stepNumber      Int
  stepName        String
  inputData       Json      @default("{}")
  outputData      Json      @default("{}")
  status          String    // PENDING, COMPLETED, FAILED, SKIPPED
  executionTimeMs Int       @default(0)
  modelUsed       String?
  error           String?
  createdAt       DateTime  @default(now())

  @@map("agent_steps")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String
  resourceType String
  resourceId   String?
  details      Json     @default("{}")
  createdAt    DateTime @default(now())

  @@map("audit_logs")
}
