# Backend Environment Variables (Render / Local)

# Database (PostgreSQL with pgvector)
DATABASE_URL="postgresql://postgres:password@ep-host.region.aws.neon.tech/neondb?sslmode=require"

# Application
PORT=5000
NODE_ENV=production
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long"
RAG_TOP_K=5

# Legal NLP Microservice (Render Free CPU)
LEGAL_NLP_URL="https://your-legal-nlp-service.onrender.com"
LEGAL_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
LEGAL_MODEL_DEVICE="cpu"
LEGAL_MAX_LENGTH=512

# Storage directory for temporary uploads / exports
UPLOAD_DIR="./storage"
